{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Waste Batteries Submit POM submission events",
    "version": "1.0.0",
    "description": "Change notifications the submit service publishes when a scheme's placed-on-market submissions are created or amended. One event covers one scheme and compliance year. It does not include tonnage, member or quarter. schemaVersion 1. A new field or a new meaning is a new version published beside this one."
  },
  "defaultContentType": "application/json",
  "channels": {
    "pomSubmissionEvents": {
      "address": "waste_batteries_submit_pom_submission_events",
      "description": "Standard SNS topic. Message attributes are eventId and eventType. A subscription with raw message delivery receives those attributes on the queue message.",
      "messages": {
        "PomSubmissionCreated": {
          "$ref": "#/components/messages/PomSubmissionCreated"
        },
        "PomSubmissionAmended": {
          "$ref": "#/components/messages/PomSubmissionAmended"
        },
        "PomSubmissionSaved": {
          "$ref": "#/components/messages/PomSubmissionSaved"
        }
      }
    }
  },
  "operations": {
    "publishPomSubmissionEvent": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/pomSubmissionEvents"
      },
      "messages": [
        {
          "$ref": "#/channels/pomSubmissionEvents/messages/PomSubmissionCreated"
        },
        {
          "$ref": "#/channels/pomSubmissionEvents/messages/PomSubmissionAmended"
        },
        {
          "$ref": "#/channels/pomSubmissionEvents/messages/PomSubmissionSaved"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "PomSubmissionCreated": {
        "name": "PomSubmissionCreated",
        "title": "POM submissions created",
        "summary": "Raised when there are solely new submission created for this scheme and year.",
        "headers": {
          "$ref": "#/components/schemas/PomSubmissionCreatedHeaders"
        },
        "payload": {
          "$ref": "#/components/schemas/PomSubmissionCreated"
        },
        "examples": [
          {
            "name": "created",
            "headers": {
              "eventId": "3f1a6c0e-4b2d-4e7a-9c11-8d5e2a7b6c40",
              "eventType": "PomSubmissionCreated"
            },
            "payload": {
              "eventId": "3f1a6c0e-4b2d-4e7a-9c11-8d5e2a7b6c40",
              "eventType": "PomSubmissionCreated",
              "schemaVersion": 1,
              "subjectId": "674a1b2c3d4e5f6789012345:2026",
              "version": 1792573200000,
              "partitionKey": "674a1b2c3d4e5f6789012345",
              "occurredAt": "2026-10-21T09:00:00.000Z",
              "actorId": "user-123",
              "correlationId": "create-outbox",
              "schemeOrgId": "674a1b2c3d4e5f6789012345",
              "compliancePeriodYear": 2026
            }
          }
        ]
      },
      "PomSubmissionAmended": {
        "name": "PomSubmissionAmended",
        "title": "POM submissions amended",
        "summary": "Raised when there are solely updated submissions saved for this scheme and year.",
        "headers": {
          "$ref": "#/components/schemas/PomSubmissionAmendedHeaders"
        },
        "payload": {
          "$ref": "#/components/schemas/PomSubmissionAmended"
        },
        "examples": [
          {
            "name": "amended",
            "headers": {
              "eventId": "6c2b7d1f-5c3e-4f8b-8d22-9e6f3b8c7d51",
              "eventType": "PomSubmissionAmended"
            },
            "payload": {
              "eventId": "6c2b7d1f-5c3e-4f8b-8d22-9e6f3b8c7d51",
              "eventType": "PomSubmissionAmended",
              "schemaVersion": 1,
              "subjectId": "674a1b2c3d4e5f6789012345:2026",
              "version": 1792573200000,
              "partitionKey": "674a1b2c3d4e5f6789012345",
              "occurredAt": "2026-10-21T09:00:00.000Z",
              "actorId": "user-123",
              "correlationId": "amend-outbox",
              "schemeOrgId": "674a1b2c3d4e5f6789012345",
              "compliancePeriodYear": 2026
            }
          }
        ]
      },
      "PomSubmissionSaved": {
        "name": "PomSubmissionSaved",
        "title": "POM submissions created and amended",
        "summary": "Raised when there are both new submissions and updated submissions saved for this scheme and year.",
        "headers": {
          "$ref": "#/components/schemas/PomSubmissionSavedHeaders"
        },
        "payload": {
          "$ref": "#/components/schemas/PomSubmissionSaved"
        },
        "examples": [
          {
            "name": "saved",
            "headers": {
              "eventId": "7d3c8e20-6d4f-409c-ae33-0f704c9d8e62",
              "eventType": "PomSubmissionSaved"
            },
            "payload": {
              "eventId": "7d3c8e20-6d4f-409c-ae33-0f704c9d8e62",
              "eventType": "PomSubmissionSaved",
              "schemaVersion": 1,
              "subjectId": "674a1b2c3d4e5f6789012345:2026",
              "version": 1792573200000,
              "partitionKey": "674a1b2c3d4e5f6789012345",
              "occurredAt": "2026-10-21T09:00:00.000Z",
              "actorId": "user-123",
              "correlationId": "batch-outbox",
              "schemeOrgId": "674a1b2c3d4e5f6789012345",
              "compliancePeriodYear": 2026
            }
          }
        ]
      }
    },
    "schemas": {
      "EventId": {
        "type": "string",
        "description": "Outbox document id, chosen before the transaction. A repeat publish carries the same id. Lower-case GUID.",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "SchemeOrgId": {
        "type": "string",
        "description": "Scheme organisation id. Lower-case ObjectId text.",
        "pattern": "^[0-9a-f]{24}$"
      },
      "OccurredAt": {
        "type": "string",
        "description": "UTC time of the commit, with millisecond precision. The same instant as version.",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
      },
      "PomSubmissionEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "eventType",
          "schemaVersion",
          "subjectId",
          "version",
          "partitionKey",
          "occurredAt",
          "actorId",
          "correlationId",
          "schemeOrgId",
          "compliancePeriodYear"
        ],
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/EventId"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "PomSubmissionCreated",
              "PomSubmissionAmended",
              "PomSubmissionSaved"
            ]
          },
          "schemaVersion": {
            "description": "Shape of this event. 1 is the first published shape.",
            "const": 1
          },
          "subjectId": {
            "type": "string",
            "description": "schemeOrgId and compliancePeriodYear, joined with a colon.",
            "pattern": "^[0-9a-f]{24}:[0-9]{4}$"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "Commit time in unix milliseconds. Every event written in one transaction shares it. A later commit is a greater number. This is not the submission row version."
          },
          "partitionKey": {
            "$ref": "#/components/schemas/SchemeOrgId"
          },
          "occurredAt": {
            "$ref": "#/components/schemas/OccurredAt"
          },
          "actorId": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque caller id from the JWT user-id claim, otherwise the name claim. No personal details beyond that claim."
          },
          "correlationId": {
            "type": "string",
            "minLength": 1,
            "description": "x-cdp-request-id when the caller sent it, otherwise the trace id, otherwise a new id."
          },
          "schemeOrgId": {
            "$ref": "#/components/schemas/SchemeOrgId"
          },
          "compliancePeriodYear": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 9999,
            "description": "Four-digit compliance year the submissions were saved against."
          }
        }
      },
      "PomSubmissionCreated": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PomSubmissionEvent"
          },
          {
            "type": "object",
            "properties": {
              "eventType": {
                "const": "PomSubmissionCreated"
              }
            }
          }
        ]
      },
      "PomSubmissionAmended": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PomSubmissionEvent"
          },
          {
            "type": "object",
            "properties": {
              "eventType": {
                "const": "PomSubmissionAmended"
              }
            }
          }
        ]
      },
      "PomSubmissionSaved": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PomSubmissionEvent"
          },
          {
            "type": "object",
            "properties": {
              "eventType": {
                "const": "PomSubmissionSaved"
              }
            }
          }
        ]
      },
      "PomSubmissionCreatedHeaders": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "eventType"],
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/EventId"
          },
          "eventType": {
            "const": "PomSubmissionCreated"
          }
        }
      },
      "PomSubmissionAmendedHeaders": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "eventType"],
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/EventId"
          },
          "eventType": {
            "const": "PomSubmissionAmended"
          }
        }
      },
      "PomSubmissionSavedHeaders": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "eventType"],
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/EventId"
          },
          "eventType": {
            "const": "PomSubmissionSaved"
          }
        }
      }
    }
  }
}
