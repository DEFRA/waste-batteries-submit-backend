<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This solution restores from nuget.org only. The user-level NuGet config also
    lists local folders. Vulnerability audit treats every source as a service index,
    and those folders produce NU1900 for https://api.nuget.org/v3/index.json.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
