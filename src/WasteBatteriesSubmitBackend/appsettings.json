{
  "Jwt": {
    // How often this process re-reads the issuer's signing keys. Five minutes is the shortest the JWT library allows.
    // One request at that moment waits for the metadata call. Raise this if that pause is more frequent than you want.
    // A missing signing key still forces a refresh, so a longer value does not bring back the stale-key 401.
    "AutomaticRefreshInterval": "00:05:00",
    // After a token is signed with a key this process does not have, wait this long before reading the keys again.
    // One second is the shortest the library allows, so a burst of bad tokens cannot fetch metadata more often than that.
    // The request that missed the key waits for that read and is checked again. Valid tokens do not trigger it.
    "RefreshInterval": "00:00:01"
  },
  "Mongo": {
    "DatabaseUri": "mongodb://set-automatically-when-deployed/admin?authSource=$external&authMechanism=MONGODB-AWS",
    "DatabaseName": "waste-batteries-submit-backend"
  },
  "PomSubmission": {
    "InitialStatus": "Submitted",
    "InitialVersion": 1,
    "InitialActivity": "Placed",
    "InitialBatteryCategory": "Portable",
    // Maximum submissions in one list response when the caller does not accept gzip. See the README.
    "MaxPageSize": 750,
    // Maximum submissions when the caller accepts gzip. See the README.
    "MaxGzipPageSize": 17000
  },
  "OutboxRelayDefault": {
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "LeaseSeconds": 60,
    "RetentionDays": 90,
    "RetryInitialDelaySeconds": 1,
    "RetryMaxDelaySeconds": 300,
    "RetryMultiplier": 2
  },
  "PomSubmissionOutboxRelay": {
    "Enabled": true,
    "TopicArn": "set-automatically-when-deployed",
    "ServiceUrl": ""
  },
  "AllowedHosts": "*",
  "TraceHeader": "x-cdp-request-id",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      }
    ]
  }
}
