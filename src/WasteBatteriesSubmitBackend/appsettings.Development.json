{
  "Jwt": {
    "MetadataAddress": "http://localhost:3200/cdp-defra-id-stub/.well-known/openid-configuration",
    "Audience": "63983fc2-cfff-45bb-8ec2-959e21062b9a",
    "RequireHttpsMetadata": false,
    "UserIdClaim": "sub",
    // How often this process re-reads the issuer's signing keys. Five minutes is the shortest the JWT library allows.
    // One request at that moment waits for the metadata call. Raise this if that pause is more frequent than you want.
    // A missing signing key still forces a refresh, so a longer value does not bring back the stale-key 401.
    "AutomaticRefreshInterval": "00:05:00",
    // After a token is signed with a key this process does not have, wait this long before reading the keys again.
    // One second is the shortest the library allows, so a burst of bad tokens cannot fetch metadata more often than that.
    // The request that missed the key waits for that read and is checked again. Valid tokens do not trigger it.
    "RefreshInterval": "00:00:01"
  },
  "Mongo": {
    "DatabaseUri": "mongodb://127.0.0.1:27017/?directConnection=true",
    "DatabaseName": "waste-batteries-submit-backend"
  },
  "PomSubmissionOutboxRelay": {
    "Enabled": true,
    "TopicArn": "arn:aws:sns:eu-west-2:000000000000:waste_batteries_submit_pom_submission_events",
    "ServiceUrl": "http://localhost:4566"
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] ({Application}/{MachineName}/{ThreadId}/{SourceContext}.{Method}) {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
