<Project>
  <!--
    Pins packages for every project in the repository.
    Each pin says why it is held and when it is safe to move.

    Change a pin here. The NuGet Package Manager does not edit this file.
    It writes a PackageReference Update into each csproj, and that Update
    replaces the pin. Directory.Build.targets fails the build when that happens.
    A version with no upper bound is only a minimum, so the Updates tab lists every
    newer release. A range keeps versions outside it off that list. Applying an
    update still writes a csproj override. Directory.Build.targets rejects that
    override for an exact pin. Snappier and SharpCompress accept any version at or above their minimum.
    The ASP.NET Core packages use one range. 11.0.0 supports net11.0 only.
  -->
  <PropertyGroup>
    <!--
      artifacts/ is build output (see .gitignore). The SDK includes every other file under a
      project as content and copies it into bin, so a build written there is copied again on
      the next build and the path grows until the copy fails.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>

    <MinimumSnappierVersion>1.1.0</MinimumSnappierVersion>
    <PinnedSnappierVersion>1.3.1</PinnedSnappierVersion>
    <MinimumSharpCompressVersion>0.48.0</MinimumSharpCompressVersion>
    <PinnedSharpCompressVersion>0.50.8</PinnedSharpCompressVersion>
    <PinnedMicrosoftOpenApiVersion>[2.13.0,3.0.0)</PinnedMicrosoftOpenApiVersion>
    <!--
      Microsoft.AspNetCore.* 11.0.0 supports net11.0 only. Restoring it on net10.0
      fails with NU1202. The upper bound keeps 11.x off the NuGet Updates tab.
      Raise the lower bound for a 10.x patch. Move the upper bound when these
      projects target net11.0.
      Applies to Authentication.JwtBearer, HeaderPropagation, Mvc.Testing, and OpenApi.
    -->
    <PinnedAspNetCore10Version>[10.0.14,11.0.0)</PinnedAspNetCore10Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Snappier before 1.1.0 is vulnerable (https://github.com/advisories/GHSA-pggp-6c3x-2vxg).
      PinnedSnappierVersion is the version restored when a project does not set its own.
      A newer version is allowed. Do not go below MinimumSnappierVersion.
    -->
    <PackageReference Include="Snappier" Version="$(PinnedSnappierVersion)" />

    <!--
      SharpCompress before 0.48.0 is vulnerable (https://github.com/advisories/GHSA-6c8g-7p36-r338).
      PinnedSharpCompressVersion is the version restored when a project does not set its own.
      A newer version is allowed. Do not go below MinimumSharpCompressVersion.
    -->
    <PackageReference Include="SharpCompress" Version="$(PinnedSharpCompressVersion)" />

    <!--
      Microsoft.OpenApi 2.7.5 or later fixes https://github.com/advisories/GHSA-v5pm-xwqc-g5wc.
      Microsoft.AspNetCore.OpenApi 10.0.13 accepts 2.x only (>= 2.12.2 and < 3.0.0).
      OpenAPI 3.x makes IOpenApiMediaType.Example read-only, and the ASP.NET OpenAPI
      source generator still assigns that property, so the build fails.
      2.13.0 is the newest 2.x release. The upper bound makes restore reject 3.x.
      Move the lower bound when a newer 2.x release exists. Move to 3.x only after
      Microsoft.AspNetCore.OpenApi declares a dependency on Microsoft.OpenApi 3.x,
      and then raise this upper bound with it.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="$(PinnedMicrosoftOpenApiVersion)" />
  </ItemGroup>

  <!--
    TEMPORARY: Add SonarAnalyzer.CSharp in its own ItemGroup, with PrivateAssets set to all,
    as waste-obligations does. Keep that separate from the package pins above.
  -->
</Project>
