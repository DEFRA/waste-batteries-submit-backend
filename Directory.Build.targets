<Project>
  <!--
    PackageReference Update in a csproj overwrites a pin from Directory.Build.props.
    That is what the NuGet Package Manager writes when an update is applied, so the
    pin would otherwise be ignored on the next restore.
    Snappier and SharpCompress are the exception: any version at or above their minimum is allowed.
  -->
  <Target Name="RejectPinnedPackageOverrides" BeforeTargets="Restore;Build">
    <ItemGroup>
      <_SnappierBelowMinimum Include="@(PackageReference)"
        Condition="'%(Identity)' == 'Snappier' and $([MSBuild]::VersionGreaterThan('$(MinimumSnappierVersion)', '%(Version)'))" />
      <_SharpCompressBelowMinimum Include="@(PackageReference)"
        Condition="'%(Identity)' == 'SharpCompress' and $([MSBuild]::VersionGreaterThan('$(MinimumSharpCompressVersion)', '%(Version)'))" />
      <_PinnedPackageOverride Include="@(PackageReference)"
        Condition="'%(Identity)' == 'Microsoft.OpenApi' and '%(Version)' != '$(PinnedMicrosoftOpenApiVersion)'">
        <PinnedVersion>$(PinnedMicrosoftOpenApiVersion)</PinnedVersion>
      </_PinnedPackageOverride>
      <_AspNetCorePackageOverride Include="@(PackageReference)"
        Condition="('%(Identity)' == 'Microsoft.AspNetCore.Authentication.JwtBearer'
          or '%(Identity)' == 'Microsoft.AspNetCore.HeaderPropagation'
          or '%(Identity)' == 'Microsoft.AspNetCore.Mvc.Testing'
          or '%(Identity)' == 'Microsoft.AspNetCore.OpenApi')
          and '%(Version)' != '$(PinnedAspNetCore10Version)'">
        <PinnedVersion>$(PinnedAspNetCore10Version)</PinnedVersion>
      </_AspNetCorePackageOverride>
    </ItemGroup>
    <Error
      Condition="'@(_SnappierBelowMinimum)' != ''"
      Text="Snappier %(_SnappierBelowMinimum.Version) is below $(MinimumSnappierVersion). Versions before $(MinimumSnappierVersion) are vulnerable (https://github.com/advisories/GHSA-pggp-6c3x-2vxg). Use $(MinimumSnappierVersion) or any newer release." />
    <Error
      Condition="'@(_SharpCompressBelowMinimum)' != ''"
      Text="SharpCompress %(_SharpCompressBelowMinimum.Version) is below $(MinimumSharpCompressVersion). Versions before $(MinimumSharpCompressVersion) are vulnerable (https://github.com/advisories/GHSA-6c8g-7p36-r338). Use $(MinimumSharpCompressVersion) or any newer release." />
    <Error
      Condition="'@(_PinnedPackageOverride)' != ''"
      Text="Package %(_PinnedPackageOverride.Identity) is pinned to %(_PinnedPackageOverride.PinnedVersion) in Directory.Build.props, but a project sets %(_PinnedPackageOverride.Version). The NuGet Package Manager writes that override into the csproj and restore ignores the pin. Delete the PackageReference version from the csproj. Change the pin in Directory.Build.props only when the update is intended." />
    <Error
      Condition="'@(_AspNetCorePackageOverride)' != ''"
      Text="Package %(_AspNetCorePackageOverride.Identity) is pinned to %(_AspNetCorePackageOverride.PinnedVersion) in Directory.Build.props, but a project sets %(_AspNetCorePackageOverride.Version). 11.0.0 supports net11.0 only and restore fails with NU1202 on net10.0. Set the PackageReference version back to $(PinnedAspNetCore10Version). Raise the lower bound in Directory.Build.props for a 10.x patch. Move the upper bound when the projects target net11.0." />
  </Target>
</Project>
