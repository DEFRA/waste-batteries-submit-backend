<Project>
  <!--
    Versions belong in Directory.Packages.props. A Version or VersionOverride in a csproj
    is what the package manager used to write when the pin lived in Directory.Build.props,
    and restore would then ignore the central version.
  -->
  <Target Name="RejectPackageVersionsOutsideCentralFile" BeforeTargets="Restore;Build">
    <ItemGroup>
      <_ProjectPackageVersion Include="@(PackageReference)"
        Condition="'%(PackageReference.Version)' != '' or '%(PackageReference.VersionOverride)' != ''" />

      <_CentralPackage Include="@(PackageVersion)">
        <BareVersion>$([System.Text.RegularExpressions.Regex]::Match('%(Version)', '[0-9]+(\.[0-9]+)+').Value)</BareVersion>
      </_CentralPackage>

      <_SnappierBelowMinimum Include="@(_CentralPackage)"
        Condition="'%(Identity)' == 'Snappier' and $([MSBuild]::VersionGreaterThan('$(MinimumSnappierVersion)', '%(BareVersion)'))" />
      <_SharpCompressBelowMinimum Include="@(_CentralPackage)"
        Condition="'%(Identity)' == 'SharpCompress' and $([MSBuild]::VersionGreaterThan('$(MinimumSharpCompressVersion)', '%(BareVersion)'))" />
      <_OpenApiTooNew Include="@(_CentralPackage)"
        Condition="'%(Identity)' == 'Microsoft.OpenApi' and $([MSBuild]::VersionGreaterThanOrEquals('%(BareVersion)', '3.0.0'))" />
      <_OpenApiTooOld Include="@(_CentralPackage)"
        Condition="'%(Identity)' == 'Microsoft.OpenApi' and $([MSBuild]::VersionGreaterThan('2.7.5', '%(BareVersion)'))" />
      <_AspNetCore11 Include="@(_CentralPackage)"
        Condition="$([System.String]::Copy('%(Identity)').StartsWith('Microsoft.AspNetCore.')) and $([MSBuild]::VersionGreaterThanOrEquals('%(BareVersion)', '11.0.0'))" />
    </ItemGroup>

    <Error
      Condition="'@(_ProjectPackageVersion)' != ''"
      Text="Package %(_ProjectPackageVersion.Identity) sets version %(_ProjectPackageVersion.Version)%(_ProjectPackageVersion.VersionOverride) in a project file. Delete that version. The NuGet Package Manager updates Directory.Packages.props, and that file is the only version list." />
    <Error
      Condition="'@(_SnappierBelowMinimum)' != ''"
      Text="Snappier %(_SnappierBelowMinimum.BareVersion) is below $(MinimumSnappierVersion). Versions before $(MinimumSnappierVersion) are vulnerable (https://github.com/advisories/GHSA-pggp-6c3x-2vxg). Set $(MinimumSnappierVersion) or any newer release in Directory.Packages.props." />
    <Error
      Condition="'@(_SharpCompressBelowMinimum)' != ''"
      Text="SharpCompress %(_SharpCompressBelowMinimum.BareVersion) is below $(MinimumSharpCompressVersion). Versions before $(MinimumSharpCompressVersion) are vulnerable (https://github.com/advisories/GHSA-6c8g-7p36-r338). Set $(MinimumSharpCompressVersion) or any newer listed release in Directory.Packages.props. Do not restore the unlisted 1.0.0 package." />
    <Error
      Condition="'@(_OpenApiTooNew)' != ''"
      Text="Microsoft.OpenApi %(_OpenApiTooNew.BareVersion) is 3.x. Microsoft.AspNetCore.OpenApi 10.x only restores 2.x, and 3.x makes IOpenApiMediaType.Example read-only, so the OpenAPI source generator fails. Keep the [2.13.1,3.0.0) range in Directory.Packages.props until the projects target net11.0." />
    <Error
      Condition="'@(_OpenApiTooOld)' != ''"
      Text="Microsoft.OpenApi %(_OpenApiTooOld.BareVersion) is below 2.7.5, which is vulnerable (https://github.com/advisories/GHSA-v5pm-xwqc-g5wc). Use 2.13.1." />
    <Error
      Condition="'@(_AspNetCore11)' != ''"
      Text="Package %(_AspNetCore11.Identity) %(_AspNetCore11.BareVersion) supports net11.0 only and does not restore on net10.0. Keep the [10.0.15,11.0.0) range in Directory.Packages.props." />
  </Target>
</Project>
